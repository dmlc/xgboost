CXX_STD = CXX17

OBJECTS =

XGBOOST_CMAKE = @CMAKE@
XGBOOST_CMAKE_SOURCE = @XGBOOST_CMAKE_SOURCE@
XGBOOST_CMAKE_BUILD = cmake-build
XGBOOST_USE_CUDA ?= OFF
XGBOOST_BUILD_WITH_FILE_PREFIX_MAP ?= ON
CMAKE_BUILD_TYPE ?= Release
# Preserve unwrapped R compilers while dependencies use launcher-wrapped CC/CXX.  If
# `XGBOOST_R_CC` is not specified by the environment, it's original compiler cmd supplied
# by R (like cl/g++).
#
# If one needs to wrap the `CC` for a launcher, like `sccache g++`, then we need the
# `XGBOOST_R_CC` to preserve the original `g++` to avoid conflict with the
# `CMAKE_<lang>_COMPILER_LAUNCHER`.
XGBOOST_R_CC ?= $(CC)
XGBOOST_R_CXX ?= $(CXX)
# Forwarding is not necessary, just stated here to make things a bit more explicit.
CMAKE_C_COMPILER_LAUNCHER ?=
CMAKE_CXX_COMPILER_LAUNCHER ?=
CMAKE_CUDA_COMPILER_LAUNCHER ?=

# Preserve R's quoting while forwarding these values as CMake arguments.
export XGBOOST_R_INCLUDE_DIR = $(R_INCLUDE_DIR)
export XGBOOST_R_LINK_FLAGS = $(ALL_LIBS)

.PHONY: all xgboost-cmake xgboost-cmake-intermediates-clean clean

all: $(SHLIB)

$(SHLIB): xgboost-cmake

# Pass original R compiler commands through `CC/CXX` environment variables, instead of
# using the CMake `-DCMAKE_CXX_COMPILER`. The `CC/CXX` might include additional args (like
# `clang++ --arg0 --arg1`), whereas the CMake CLI flag uses a different syntax (separated
# by `;` instead of space).
#
# Also, since we support CUDA build, we cannot use the R's `CXX` as is and has to route
# through the `XGBOOST_R_CXX`. Otherwise, `sccache g++` could become the CMake CUDA host
# compiler.
xgboost-cmake:
	+@set -eu; \
	xgboost_use_openmp=OFF; \
	if test -n "$(SHLIB_OPENMP_CXXFLAGS)"; then xgboost_use_openmp=ON; fi; \
	CC="$(XGBOOST_R_CC)" CXX="$(XGBOOST_R_CXX)" \
	"$(XGBOOST_CMAKE)" \
	  -S "$(XGBOOST_CMAKE_SOURCE)" \
	  -B "$(XGBOOST_CMAKE_BUILD)" \
	  -G "Unix Makefiles" \
	  -DR_LIB=ON \
	  -DKEEP_BUILD_ARTIFACTS_IN_BINARY_DIR=ON \
	  "-DXGBOOST_R_INCLUDE_DIR=$${XGBOOST_R_INCLUDE_DIR}" \
	  "-DXGBOOST_R_LINK_FLAGS=$${XGBOOST_R_LINK_FLAGS}" \
	  -DUSE_OPENMP=$${xgboost_use_openmp} \
	  -DUSE_CUDA="$(XGBOOST_USE_CUDA)" \
	  -DBUILD_WITH_FILE_PREFIX_MAP="$(XGBOOST_BUILD_WITH_FILE_PREFIX_MAP)" \
	  -DCMAKE_BUILD_TYPE="$(CMAKE_BUILD_TYPE)" \
	  -DCMAKE_C_FLAGS_RELEASE= \
	  -DCMAKE_CXX_FLAGS_RELEASE= \
	  -DCMAKE_CUDA_FLAGS_RELEASE= \
	  -DCMAKE_C_FLAGS="$(ALL_CPPFLAGS) $(ALL_CFLAGS) $(SHLIB_OPENMP_CFLAGS)" \
	  -DCMAKE_CXX_FLAGS="$(ALL_CPPFLAGS) $(ALL_CXXFLAGS) $(SHLIB_OPENMP_CXXFLAGS)" \
	  -DCMAKE_CUDA_FLAGS="$(ALL_CPPFLAGS) $(ALL_CXXFLAGS)" \
	  -DCMAKE_SHARED_LINKER_FLAGS="$(SHLIB_LDFLAGS) $(LDFLAGS) $(SHLIB_OPENMP_CXXFLAGS)" \
	  -DCMAKE_OSX_DEPLOYMENT_TARGET="$(MACOSX_DEPLOYMENT_TARGET)" \
	  -DCMAKE_MAKE_PROGRAM="$(MAKE)" \
	  -DCMAKE_C_COMPILER_LAUNCHER="$(CMAKE_C_COMPILER_LAUNCHER)" \
	  -DCMAKE_CXX_COMPILER_LAUNCHER="$(CMAKE_CXX_COMPILER_LAUNCHER)" \
	  -DCMAKE_CUDA_COMPILER_LAUNCHER="$(CMAKE_CUDA_COMPILER_LAUNCHER)"
	+@"$(XGBOOST_CMAKE)" --build "$(XGBOOST_CMAKE_BUILD)" --target xgboost
	@"$(XGBOOST_CMAKE)" -E copy "$(XGBOOST_CMAKE_BUILD)/lib/$(SHLIB)" "$(SHLIB)"

clean: xgboost-cmake-intermediates-clean

shlib-clean: xgboost-cmake-intermediates-clean

xgboost-cmake-intermediates-clean:
	@"$(XGBOOST_CMAKE)" -E remove_directory "$(XGBOOST_CMAKE_BUILD)"
